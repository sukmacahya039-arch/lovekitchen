# Application runtime port (AI Studio requires 3000)
PORT=3000

# Public URL where this applet is hosted
APP_URL="http://localhost:3000"

# Optional external Socket.IO server URL (leave empty to connect to same origin)
VITE_SOCKET_URL=""

# Optional Supabase PostgreSQL credentials for self-hosted deployments
# (AI Studio runtime uses provisioned Firestore automatically via firebase-applet-config.json)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
